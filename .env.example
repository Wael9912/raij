# Copy to .env and fill in. See SETUP.md for how to obtain each value.

# --- LLM (fallback order set in config.yaml) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Discovery ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=raij/0.1 by <your_reddit_username>

# --- B-roll ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Review ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publishing ---
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
YOUTUBE_OAUTH_CLIENT_SECRET_FILE=client_secret.json

# --- Paths ---
RAIJ_DB_PATH=data/pipeline.db

# --- Rendering ---
FFMPEG_BIN=ffmpeg
